{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "x64",
      "displayName": "x64",
      "inherits": "base",
      "architecture": { "value": "x64", "strategy": "set" }
    },
    {
      "name": "arm64",
      "displayName": "ARM64",
      "inherits": "base",
      "architecture": { "value": "ARM64", "strategy": "set" }
    }
  ],
  "buildPresets": [
    { "name": "x64-debug", "configurePreset": "x64", "configuration": "Debug" },
    { "name": "x64-release", "configurePreset": "x64", "configuration": "Release" },
    { "name": "arm64-debug", "configurePreset": "arm64", "configuration": "Debug" },
    { "name": "arm64-release", "configurePreset": "arm64", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "x64-release",
      "configurePreset": "x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
