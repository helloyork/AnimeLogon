    BEGIN
        // zh-CN, Unicode: the descriptions are Chinese.
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      ANIMELOGON_COMPANY
            VALUE "FileDescription",  "@ANIMELOGON_DESC@"
            VALUE "FileVersion",      ANIMELOGON_FILE_VERSION
            VALUE "InternalName",     "@ANIMELOGON_FILE@"
            VALUE "LegalCopyright",   ANIMELOGON_COPYRIGHT
            VALUE "OriginalFilename", "@ANIMELOGON_FILE@"
            VALUE "ProductName",      ANIMELOGON_DISPLAY_NAME
            VALUE "ProductVersion",   ANIMELOGON_VERSION
        END
