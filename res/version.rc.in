 PRODUCTVERSION ANIMELOGON_VERSION_MAJOR, ANIMELOGON_VERSION_MINOR, ANIMELOGON_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
