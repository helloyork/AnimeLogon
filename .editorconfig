root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_size = 2

# A verbatim copy of another repository; leave its bytes alone.
[vendor/**]
charset = unset
end_of_line = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
